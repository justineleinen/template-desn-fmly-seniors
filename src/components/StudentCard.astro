---
const { name, image, favorite_emoji, github_permalink, github_profile, codepen_profile } = Astro.props;
const slug = name.toLowerCase().replace(/\s+/g, "-");
---
<figure class="card">
  <img src={image} alt={name} loading="lazy" />
  <figcaption>
    <div class="card-name">
      <a href={`/${slug}`}><span class="card-emoji">{favorite_emoji}</span> {name}</a>
    </div>
    <nav class="card-links">
      <a href={github_permalink} target="_blank" rel="noopener">Portfolio</a>
      <a href={github_profile} target="_blank" rel="noopener">GitHub</a>
      <a href={codepen_profile} target="_blank" rel="noopener">CodePen</a>
    </nav>
  </figcaption>
</figure>
<style>
  .card {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: #f9c6d0;
  }
  .card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  figcaption {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .card-name a {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }
  .card-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .card-links a {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0f0f0f;
    background: #f9c6d0;
    text-decoration: none;
    padding: 0.3rem 0.65rem;
    transition: background 0.2s ease;
  }
  .card-links a:hover {
    background: #fff;
  }
</style>
